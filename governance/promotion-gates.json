  "promotion_gate": {
    "job_name": "promotion-gate",
    "must_require": [
      "deterministic_matrix",
      "real_trivy_consumer",
      "real_osv_consumer"
    ]
  },
  "legacy_required_context_bridge": {
    "reason": "Existing branch protection requires five historical matrix context names. Those names are preserved as downstream anchors so none can succeed unless the full promotion gate succeeds.",
    "contexts": [
      "verify-evidence (matching-clean, evidence/clean/receipt.json, pass)",
      "verify-evidence (digest-mismatch, evidence/inconclusive/receipt.json, inconclusive)",
      "verify-evidence (stale, evidence/inconclusive/stale.json, inconclusive)",
      "verify-evidence (findings, evidence/fail/findings.json, fail)",
      "verify-evidence (malformed-receipt, evidence/fail/malformed.json, fail)"
    ],
    "migration_target": "Replace legacy anchors with a single required promotion-gate context when repository settings governance is updated."
  },
  "runtime_evidence_retention": {
    "retention_days": 90,
    "bundles": {
      "real_trivy": {
        "artifact_name_prefix": "real-trivy-runtime-evidence-",
        "files": [
          "runtime-evidence-manifest.json",
          "receipt.json",
          "evidence.json",
          "trivy.raw.json",
          "trivy.stderr.log"
        ]
      },
      "real_osv": {
        "artifact_name_prefix": "real-osv-runtime-evidence-",
        "files": [
          "runtime-evidence-manifest.json",
          "receipt.json",
          "evidence.json",
          "osv.raw.json",
          "osv.stderr.log"
        ]
      }
    }
  }
